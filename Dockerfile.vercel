FROM tomcat:11.0-jdk21

# 1. 删除 Tomcat 默认的 ROOT 应用，避免冲突
RUN rm -rf /usr/local/tomcat/webapps/*

# 2. 复制你本地打好的 war 包到 Tomcat 根路径
# 注意：路径要和你的项目结构匹配，target 目录下必须有 yjt1012.war
COPY target/yjt1012.war /usr/local/tomcat/webapps/ROOT.war

# 3. 让 Tomcat 监听 Vercel 提供的 PORT 环境变量（默认 80）
# 这里使用 sed 把默认端口 8080 替换成 ${PORT} 占位符，然后用 envsubst 动态生成配置
RUN apt-get update && apt-get install -y gettext-base && rm -rf /var/lib/apt/lists/*

# 把 server.xml 里的 8080 端口改成 ${PORT} 占位符
RUN sed -i 's/port="8080"/port="${PORT}"/' /usr/local/tomcat/conf/server.xml

# 创建一个启动脚本，在启动时用 envsubst 替换 ${PORT} 为实际端口值
RUN echo '#!/bin/sh\n\
envsubst < /usr/local/tomcat/conf/server.xml > /usr/local/tomcat/conf/server.xml.tmp\n\
mv /usr/local/tomcat/conf/server.xml.tmp /usr/local/tomcat/conf/server.xml\n\
exec catalina.sh run' > /usr/local/tomcat/start.sh && chmod +x /usr/local/tomcat/start.sh

EXPOSE 80
CMD ["/usr/local/tomcat/start.sh"]